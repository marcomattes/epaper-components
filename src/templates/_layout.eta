<% /* pathPrefix: '../' for /demo/ pages, '' for root. navPrefix: '' for /demo/ pages, 'demo/' for root */ %>
<% const pp = it.pathPrefix ?? '../'; const np = it.navPrefix ?? ''; %>
<!doctype html>
<html lang="en" data-theme="default">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= it.title %> — epaper-components</title>
<% if (it.description) { %>
    <meta name="description" content="<%= it.description %>" />
<% } else { %>
    <meta name="description" content="epaper-components is a CSS-only component library with 46+ components optimized for E-Ink displays. Zero JavaScript, three themes, optional Web Components." />
<% } %>
    <meta name="author" content="Marco Mattes" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="<%= it.title %> — epaper-components" />
<% if (it.description) { %>
    <meta property="og:description" content="<%= it.description %>" />
<% } else { %>
    <meta property="og:description" content="CSS-only component library with 46+ components optimized for E-Ink displays. Zero JavaScript, three themes, optional Web Components." />
<% } %>
    <meta property="og:site_name" content="epaper-components" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="<%= it.title %> — epaper-components" />
<% if (it.description) { %>
    <meta name="twitter:description" content="<%= it.description %>" />
<% } %>

    <link rel="stylesheet" href="<%= pp %>dist/epaper-components.css" />
    <link rel="icon" href="<%= pp %>assets/epaper-components-logo.svg" type="image/svg+xml" />
    <link rel="canonical" href="<%= it.canonical || '' %>" />
<% if (it.fullHeader) { %>
    <script src="<%= np %>theme.js" defer></script>
<% } %>
<% if (it.headExtra) { %>
<%~ it.headExtra + '\n' %><% } %>
  </head>
  <body>
    <header class="epaper-page-header">
      <div class="epaper-container<%= it.wide ? ' epaper-container--wide' : '' %>">
<% if (it.fullHeader) { %>
        <div class="epaper-cluster" style="align-items: center; gap: var(--epaper-space-3)">
          <img
            src="<%= pp %>assets/epaper-components-logo.svg"
            alt="epaper-components"
            width="120"
            height="32"
            loading="lazy"
          />
          <h1 style="font-size: var(--epaper-text-2xl); margin: 0">epaper-components</h1>
        </div>
<% } else { %>
        <h1 style="font-size: var(--epaper-text-2xl); margin-bottom: var(--epaper-space-2)">
          epaper-components
        </h1>
<% } %>
        <nav class="epaper-nav" aria-label="Main navigation">
          <a href="<%= np %>index.html"<%= it.current === 'index' ? ' aria-current="page"' : '' %>>Overview</a>
          <a href="<%= np %>typography.html"<%= it.current === 'typography' ? ' aria-current="page"' : '' %>>Typography</a>
          <a href="<%= np %>layout.html"<%= it.current === 'layout' ? ' aria-current="page"' : '' %>>Layout</a>
          <a href="<%= np %>components.html"<%= it.current === 'components' ? ' aria-current="page"' : '' %>>Components</a>
          <a href="<%= np %>forms.html"<%= it.current === 'forms' ? ' aria-current="page"' : '' %>>Forms</a>
          <a href="<%= np %>dialog.html"<%= it.current === 'dialog' ? ' aria-current="page"' : '' %>>Dialog</a>
          <a href="<%= np %>tables.html"<%= it.current === 'tables' ? ' aria-current="page"' : '' %>>Tables</a>
          <a href="<%= np %>newsreader.html"<%= it.current === 'newsreader' ? ' aria-current="page"' : '' %>>Newsreader</a>
          <a href="<%= np %>blog.html"<%= it.current === 'blog' ? ' aria-current="page"' : '' %>>Blog</a>
          <a href="<%= np %>dashboard.html"<%= it.current === 'dashboard' ? ' aria-current="page"' : '' %>>Dashboard</a>
        </nav>
        <p class="epaper-text-xs" style="margin-top: var(--epaper-space-1); display: flex; gap: var(--epaper-space-3); align-items: center; flex-wrap: wrap;">
          <a href="<%= pp %>demo-wc/index.html"><strong>Switch to Web Component demos</strong></a>
          <span aria-hidden="true">·</span>
          <a href="https://epaper-components.dev/storybook/"><strong>View Storybook</strong></a>
        </p>
<% if (it.fullHeader) { %>
        <p
          class="epaper-text-xs epaper-text-muted"
          style="
            margin-top: var(--epaper-space-2);
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem 1rem;
            align-items: center;
          "
        >
          <span>Theme: <code data-theme-label>default</code></span>
          <span aria-hidden="true">·</span>
          <a href="?theme=default">Default</a>
          <a href="?theme=inverted">Inverted</a>
          <a href="?theme=high-contrast">High-contrast</a>
          <span aria-hidden="true">·</span>
          <span
            >Set <code>data-theme="..."</code> on <code>&lt;html&gt;</code> for no-JS
            use.</span
          >
        </p>
<% } else { %>
        <p class="epaper-text-xs epaper-text-muted" style="margin-top: var(--epaper-space-2)">
          Theme: <code>default</code>
        </p>
<% } %>
      </div>
    </header>
<%~ it.body %>

    <footer class="epaper-page-footer">
      <div class="epaper-container<%= it.wide ? ' epaper-container--wide' : '' %>">
        <small><%= it.footerText || 'epaper-components — CSS-only component library for E-Ink devices.' %></small>
      </div>
    </footer>
<% if (it.bodyEnd) { %>

<%~ it.bodyEnd + '\n' %><% } %>
  </body>
</html>
