<% layout("../_wc-layout", { title: "Overview", current: "index" }) %>

    <main class="eink-container eink-stack">
      <section class="eink-section">
        <h2>Web Components</h2>
        <p>
          These demos show <strong>eink-ui</strong> components rendered as
          <strong>custom elements</strong> (Light-DOM Web Components). The same CSS
          library powers both approaches — the web components simply map element
          attributes to the underlying <code>.eink-*</code> classes automatically.
        </p>
        <p class="eink-note">
          Web components require a small JavaScript module
          (<code>dist/wc/index.js</code>). If you need zero-JS output, use the
          <a href="../demo/index.html">CSS-only demos</a> instead.
        </p>
      </section>

      <section class="eink-section">
        <h2>Setup</h2>
        <pre><code>&lt;link rel="stylesheet" href="dist/eink-ui.css"&gt;
&lt;script type="module"&gt;
  import { defineEinkElements } from "dist/wc/index.js";
  defineEinkElements();
&lt;/script&gt;</code></pre>
        <p>
          After calling <code>defineEinkElements()</code>, all custom elements are
          registered and ready to use.
        </p>
      </section>

      <section class="eink-section">
        <h2>Available components</h2>

        <h3 style="margin-top: var(--eink-space-4)">Layout primitives</h3>
        <div class="eink-table-wrap" style="margin-top: var(--eink-space-3)">
          <table class="eink-table eink-table--compact">
            <thead>
              <tr>
                <th scope="col">Custom element</th>
                <th scope="col">CSS equivalent</th>
                <th scope="col">Key attributes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>&lt;eink-container&gt;</code></td>
                <td><code>.eink-container</code></td>
                <td><code>width="wide|narrow"</code></td>
              </tr>
              <tr>
                <td><code>&lt;eink-stack&gt;</code></td>
                <td><code>.eink-stack</code></td>
                <td><code>gap="sm|lg"</code></td>
              </tr>
              <tr>
                <td><code>&lt;eink-cluster&gt;</code></td>
                <td><code>.eink-cluster</code></td>
                <td><code>gap="..."</code> (CSS value)</td>
              </tr>
              <tr>
                <td><code>&lt;eink-grid&gt;</code></td>
                <td><code>.eink-grid</code></td>
                <td><code>min="..."</code> (CSS value)</td>
              </tr>
              <tr>
                <td><code>&lt;eink-divider&gt;</code></td>
                <td><code>.eink-divider</code></td>
                <td><code>strong</code></td>
              </tr>
              <tr>
                <td><code>&lt;eink-section&gt;</code></td>
                <td><code>.eink-section</code></td>
                <td>—</td>
              </tr>
              <tr>
                <td><code>&lt;eink-page-header&gt;</code></td>
                <td><code>.eink-page-header</code></td>
                <td>—</td>
              </tr>
              <tr>
                <td><code>&lt;eink-page-footer&gt;</code></td>
                <td><code>.eink-page-footer</code></td>
                <td>—</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 style="margin-top: var(--eink-space-5)">UI components</h3>
        <div class="eink-table-wrap" style="margin-top: var(--eink-space-3)">
          <table class="eink-table eink-table--compact">
            <thead>
              <tr>
                <th scope="col">Custom element</th>
                <th scope="col">CSS equivalent</th>
                <th scope="col">Key attributes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>&lt;eink-button&gt;</code></td>
                <td><code>.eink-btn</code></td>
                <td><code>variant</code>, <code>size</code>, <code>disabled</code></td>
              </tr>
              <tr>
                <td><code>&lt;eink-card&gt;</code></td>
                <td><code>.eink-card</code></td>
                <td><code>raised</code></td>
              </tr>
              <tr>
                <td><code>&lt;eink-alert&gt;</code></td>
                <td><code>.eink-alert</code></td>
                <td><code>variant="info|success|warning|error"</code></td>
              </tr>
              <tr>
                <td><code>&lt;eink-tag&gt;</code></td>
                <td><code>.eink-tag</code></td>
                <td><code>variant="filled|muted"</code></td>
              </tr>
              <tr>
                <td><code>&lt;eink-badge&gt;</code></td>
                <td><code>.eink-badge</code></td>
                <td>—</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h3 style="margin-top: var(--eink-space-5)">Form components</h3>
        <div class="eink-table-wrap" style="margin-top: var(--eink-space-3)">
          <table class="eink-table eink-table--compact">
            <thead>
              <tr>
                <th scope="col">Custom element</th>
                <th scope="col">CSS equivalent</th>
                <th scope="col">Key attributes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>&lt;eink-input&gt;</code></td>
                <td><code>.eink-input</code></td>
                <td><code>type</code>, <code>placeholder</code>, <code>disabled</code>, <code>aria-invalid</code></td>
              </tr>
              <tr>
                <td><code>&lt;eink-textarea&gt;</code></td>
                <td><code>.eink-textarea</code></td>
                <td><code>placeholder</code>, <code>disabled</code>, <code>aria-invalid</code></td>
              </tr>
              <tr>
                <td><code>&lt;eink-select&gt;</code></td>
                <td><code>.eink-select</code></td>
                <td><code>disabled</code>, <code>aria-invalid</code></td>
              </tr>
              <tr>
                <td><code>&lt;eink-checkbox&gt;</code></td>
                <td><code>.eink-checkbox</code></td>
                <td><code>checked</code>, <code>disabled</code>, <code>name</code>, <code>value</code></td>
              </tr>
              <tr>
                <td><code>&lt;eink-radio&gt;</code></td>
                <td><code>.eink-radio</code></td>
                <td><code>checked</code>, <code>disabled</code>, <code>name</code>, <code>value</code></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="eink-section">
        <h2>Demo pages</h2>
        <ul>
          <li>
            <a href="layout.html">Layout</a> — container, stack, cluster, grid,
            divider, page structure
          </li>
          <li>
            <a href="components.html">Components</a> — card, button, alert, tag,
            badge
          </li>
          <li>
            <a href="forms.html">Forms</a> — input, textarea, select, checkbox,
            radio
          </li>
        </ul>
        <p style="margin-top: var(--eink-space-3)">
          <a href="../demo/index.html">View CSS-only demos</a> for typography,
          tables, dialog, and full-page examples (newsreader, blog, dashboard).
        </p>
      </section>

      <section class="eink-section">
        <h2>CSS-only vs Web Components</h2>
        <div class="eink-table-wrap" style="margin-top: var(--eink-space-3)">
          <table class="eink-table eink-table--bordered">
            <thead>
              <tr>
                <th scope="col">Aspect</th>
                <th scope="col">CSS-only</th>
                <th scope="col">Web Components</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>JavaScript required</td>
                <td>No</td>
                <td>Yes (small module)</td>
              </tr>
              <tr>
                <td>Authoring</td>
                <td><code>class="eink-btn eink-btn--primary"</code></td>
                <td><code>&lt;eink-button variant="primary"&gt;</code></td>
              </tr>
              <tr>
                <td>Attribute sync</td>
                <td>Manual class management</td>
                <td>Automatic via observed attributes</td>
              </tr>
              <tr>
                <td>Shadow DOM</td>
                <td>N/A</td>
                <td>None (Light DOM)</td>
              </tr>
              <tr>
                <td>E-Ink compatibility</td>
                <td>Maximum</td>
                <td>Same CSS, minimal JS overhead</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>
