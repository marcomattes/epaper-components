<% layout("../_layout", { title: "Layout", current: "layout", fullHeader: true, headExtra: `    <style>
      /* Demo-only: visible outlines for layout boxes */
      .demo-box {
        border: 1px dashed var(--epaper-border-color);
        padding: var(--epaper-space-3);
        text-align: center;
        font-size: var(--epaper-text-sm);
        color: var(--epaper-fg-muted);
        background: var(--epaper-bg-subtle);
      }
    </style>` }) %>

    <main class="epaper-container epaper-stack">
      <!-- CONTAINER -->
      <section class="epaper-section">
        <h2>Container</h2>
        <p class="epaper-note">
          E-Ink rationale: Fixed max-widths prevent content from stretching across wide
          displays (like the 10.3" Kindle Scribe), reducing eye-tracking effort and
          partial-refresh regions.
        </p>
        <p class="epaper-text-sm">
          The <code>.epaper-container</code> centers content with horizontal padding.
          Variants: <code>--narrow</code> (38rem), default (52rem),
          <code>--wide</code> (72rem).
        </p>

        <div
          style="
            margin-top: var(--epaper-space-4);
            border: var(--epaper-border-thin) solid var(--epaper-border-color);
          "
        >
          <div
            class="epaper-container--narrow"
            style="
              max-width: 38rem;
              margin-inline: auto;
              padding-inline: var(--epaper-space-4);
            "
          >
            <div class="demo-box">Narrow container (38rem)</div>
          </div>
        </div>
        <div
          style="
            margin-top: var(--epaper-space-3);
            border: var(--epaper-border-thin) solid var(--epaper-border-color);
          "
        >
          <div class="epaper-container" style="padding-block: 0">
            <div class="demo-box">Default container (52rem)</div>
          </div>
        </div>
        <div
          style="
            margin-top: var(--epaper-space-3);
            border: var(--epaper-border-thin) solid var(--epaper-border-color);
          "
        >
          <div
            class="epaper-container--wide"
            style="
              max-width: 72rem;
              margin-inline: auto;
              padding-inline: var(--epaper-space-4);
            "
          >
            <div class="demo-box">Wide container (72rem)</div>
          </div>
        </div>
      </section>

      <!-- STACK -->
      <section class="epaper-section">
        <h2>Stack</h2>
        <p class="epaper-text-sm">
          Vertical rhythm via <code>flex-direction: column</code> + <code>gap</code>.
          Variants: <code>--sm</code>, default, <code>--lg</code>.
        </p>
        <p class="epaper-note">
          E-Ink rationale: Consistent vertical spacing prevents layout shifts during
          partial screen refreshes and provides clear visual separation between content
          blocks.
        </p>

        <div
          class="epaper-grid"
          style="--epaper-grid-min: 14rem; margin-top: var(--epaper-space-4)"
        >
          <div>
            <span class="epaper-badge">Stack --sm</span>
            <div
              class="epaper-stack epaper-stack--sm"
              style="margin-top: var(--epaper-space-2)"
            >
              <div class="demo-box">Item 1</div>
              <div class="demo-box">Item 2</div>
              <div class="demo-box">Item 3</div>
            </div>
          </div>
          <div>
            <span class="epaper-badge">Stack (default)</span>
            <div class="epaper-stack" style="margin-top: var(--epaper-space-2)">
              <div class="demo-box">Item 1</div>
              <div class="demo-box">Item 2</div>
              <div class="demo-box">Item 3</div>
            </div>
          </div>
          <div>
            <span class="epaper-badge">Stack --lg</span>
            <div
              class="epaper-stack epaper-stack--lg"
              style="margin-top: var(--epaper-space-2)"
            >
              <div class="demo-box">Item 1</div>
              <div class="demo-box">Item 2</div>
              <div class="demo-box">Item 3</div>
            </div>
          </div>
        </div>
      </section>

      <!-- CLUSTER -->
      <section class="epaper-section">
        <h2>Cluster</h2>
        <p class="epaper-text-sm">
          Horizontal wrapping layout using <code>flex-wrap</code>. Items flow
          left-to-right and wrap naturally.
        </p>
        <p class="epaper-note">
          E-Ink rationale: Wrapping layouts adapt to narrow E-Ink screens without
          requiring media queries. This reduces the amount of conditional layout logic.
        </p>

        <div class="epaper-cluster" style="margin-top: var(--epaper-space-4)">
          <div class="demo-box">Alpha</div>
          <div class="demo-box">Bravo</div>
          <div class="demo-box">Charlie</div>
          <div class="demo-box">Delta</div>
          <div class="demo-box">Echo</div>
          <div class="demo-box">Foxtrot</div>
          <div class="demo-box">Golf</div>
        </div>
      </section>

      <!-- GRID -->
      <section class="epaper-section">
        <h2>Grid</h2>
        <p class="epaper-text-sm">
          Auto-fit responsive grid using <code>minmax()</code>. Set
          <code>--epaper-grid-min</code> to control the minimum column width.
        </p>
        <p class="epaper-note">
          E-Ink rationale: <code>auto-fit</code> with <code>minmax()</code> produces a
          stable layout with no layout shifts on resize — important because E-Ink
          devices occasionally rotate or change viewport size between
          landscape/portrait.
        </p>

        <div style="margin-top: var(--epaper-space-4)">
          <span class="epaper-badge">Default (16rem min)</span>
          <div class="epaper-grid" style="margin-top: var(--epaper-space-2)">
            <div class="demo-box">Cell 1</div>
            <div class="demo-box">Cell 2</div>
            <div class="demo-box">Cell 3</div>
            <div class="demo-box">Cell 4</div>
            <div class="demo-box">Cell 5</div>
            <div class="demo-box">Cell 6</div>
          </div>
        </div>

        <div style="margin-top: var(--epaper-space-5)">
          <span class="epaper-badge">Wider columns (22rem min)</span>
          <div
            class="epaper-grid"
            style="--epaper-grid-min: 22rem; margin-top: var(--epaper-space-2)"
          >
            <div class="demo-box">Cell 1</div>
            <div class="demo-box">Cell 2</div>
            <div class="demo-box">Cell 3</div>
            <div class="demo-box">Cell 4</div>
          </div>
        </div>
      </section>

      <!-- DIVIDER -->
      <section class="epaper-section">
        <h2>Divider</h2>
        <p class="epaper-text-sm">
          Simple horizontal rules. Use <code>.epaper-divider--strong</code> for heavier
          separators.
        </p>
        <p class="epaper-note">
          E-Ink rationale: Thin rules are efficient to render and provide clear visual
          separation without large filled surfaces that cause ghosting.
        </p>

        <div style="margin-top: var(--epaper-space-4)">
          <p>Content above the default divider.</p>
          <hr class="epaper-divider" />
          <p>Content between dividers.</p>
          <hr class="epaper-divider epaper-divider--strong" />
          <p>Content below the strong divider.</p>
        </div>
      </section>

      <!-- PAGE STRUCTURE -->
      <section class="epaper-section">
        <h2>Page structure</h2>
        <p class="epaper-text-sm">
          Page header, section, and footer patterns. This very page demonstrates all
          three. The header is bordered at the bottom, sections separate with thin
          rules, and the footer is bordered at the top.
        </p>

        <div
          style="
            margin-top: var(--epaper-space-4);
            border: var(--epaper-border-thin) solid var(--epaper-border-color);
          "
        >
          <div class="epaper-page-header" style="margin-bottom: 0">
            <div style="padding-inline: var(--epaper-space-4)">
              <strong>Page Header</strong>
              <span class="epaper-text-sm epaper-text-muted">
                — border-bottom, padding</span
              >
            </div>
          </div>
          <div class="epaper-section" style="padding-inline: var(--epaper-space-4)">
            <p>Section 1 content</p>
          </div>
          <div class="epaper-section" style="padding-inline: var(--epaper-space-4)">
            <p>Section 2 content (auto border-top between adjacent sections)</p>
          </div>
          <div class="epaper-page-footer" style="margin-top: 0">
            <div style="padding-inline: var(--epaper-space-4)">
              <small>Page Footer — border-top, padding</small>
            </div>
          </div>
        </div>
      </section>
    </main>
