{
  "name": "epaper-components-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @marcomattes/epaper-components: the component library, its docs/marketing site, Storybook, and consumer sample apps.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w packages/epaper-components",
    "start": "npm run start -w packages/epaper-components",
    "build": "npm run build -w packages/epaper-components",
    "dev:site": "npm run dev -w apps/site",
    "build:site": "npm run build -w apps/site",
    "preview:site": "npm run preview -w apps/site",
    "dev:bookstore": "npm run dev -w apps/bookstore",
    "build:bookstore": "npm run build -w apps/bookstore",
    "preview:bookstore": "npm run preview -w apps/bookstore",
    "preview": "npm run preview -w packages/epaper-components",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"packages/epaper-components/src/**/*.ts\" \"apps/site/src/**/*.ts\" \"apps/bookstore/src/**/*.ts\" && stylelint \"packages/*/src/styles/**/*.css\"",
    "lint:check": "eslint \"packages/epaper-components/src/**/*.ts\" \"apps/site/src/**/*.ts\" \"apps/bookstore/src/**/*.ts\" --max-warnings=0 && stylelint \"packages/*/src/styles/**/*.css\"",
    "format": "prettier --write \"packages/*/src/**/*.{ts,css}\" \"apps/*/src/**/*.{ts,css}\" \"*.{md,json,mjs,ts}\" \"packages/*/*.{json,mjs,ts}\" \"apps/*/*.{json,mjs,ts}\" \"packages/*/scripts/**/*.mjs\" \"apps/*/scripts/**/*.mjs\" \"apps/storybook/.storybook/**/*.ts\" \"apps/sample-app/**/*.{ts,mjs,html}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,css}\" \"apps/*/src/**/*.{ts,css}\" \"*.{md,json,mjs,ts}\" \"packages/*/*.{json,mjs,ts}\" \"apps/*/*.{json,mjs,ts}\" \"packages/*/scripts/**/*.mjs\" \"apps/*/scripts/**/*.mjs\" \"apps/storybook/.storybook/**/*.ts\" \"apps/sample-app/**/*.{ts,mjs,html}\"",
    "analyze": "npm run analyze -w packages/epaper-components",
    "docs:components": "npm run docs:components -w packages/epaper-components",
    "analyze:watch": "npm run analyze:watch -w packages/epaper-components",
    "storybook": "npm run storybook -w apps/storybook",
    "build-storybook": "npm run build-storybook -w apps/storybook",
    "browserstack:serve": "npm run browserstack:serve -w apps/storybook",
    "test": "vitest",
    "test:ci": "vitest run",
    "test-storybook": "vitest --project=storybook",
    "test:visual": "vitest run packages/epaper-components/src/components/__tests__/screenshots.test.ts",
    "test:visual:update": "npm run test:visual -- --update",
    "test:refresh": "vitest run packages/epaper-components/src/components/__tests__/refresh-budget.test.ts",
    "test:browserstack": "npm run test:browserstack -w apps/storybook",
    "test:coverage": "vitest --coverage",
    "test:coverage:ci": "vitest run --coverage",
    "size": "npm run size -w packages/epaper-components",
    "size:why": "npm run size:why -w packages/epaper-components",
    "test:ssr": "npm run test:ssr -w packages/epaper-components",
    "validate:sample-app": "npm run validate -w apps/sample-app",
    "validate:sample-app:types": "npm run types-check -w apps/sample-app",
    "pages:index": "npm run pages:index -w apps/site",
    "bump-version": "npm run bump-version -w packages/epaper-components --",
    "build-browserstack": "npm run build-browserstack -w packages/epaper-components",
    "build:site-browserstack": "npm run build-browserstack -w apps/site",
    "analyze-browserstack": "npm run analyze-browserstack -w packages/epaper-components",
    "docs:components-browserstack": "npm run docs:components-browserstack -w packages/epaper-components",
    "browserstack:serve-browserstack": "npm run browserstack:serve-browserstack -w apps/storybook",
    "test:browserstack-browserstack": "npm run test:browserstack-browserstack -w apps/storybook",
    "validate:sample-app-browserstack": "npm run validate-browserstack -w apps/sample-app",
    "pages:index-browserstack": "npm run pages:index-browserstack -w apps/site",
    "bump-version-browserstack": "npm run bump-version-browserstack -w packages/epaper-components --"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@eslint/js": "10.0.1",
    "@size-limit/preset-small-lib": "13.1.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/web-components": "10.6.0",
    "@storybook/web-components-vite": "10.6.0",
    "@vitest/browser": "5.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "browserstack-node-sdk": "^1.70.0",
    "custom-element-jet-brains-integration": "1.8.0",
    "custom-element-vs-code-integration": "1.5.0",
    "eslint": "10.10.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "74.0.0",
    "lightningcss": "1.33.0",
    "lit": "3.3.3",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "remark-gfm": "4.0.1",
    "size-limit": "13.1.1",
    "storybook": "10.6.0",
    "stylelint": "17.15.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "vitest-sonar-reporter": "3.0.0"
  },
  "overrides": {
    "rolldown": "1.2.4"
  }
}
