  "files": [
    "dist",
    "src/styles",
    "README.md",
    "OVERVIEW.md",
    "THEMING.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "contributes": {
    "html": {
      "customData": [
        "./dist/vscode.html-custom-data.json"
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && node scripts/build-css.mjs && tsc -p tsconfig.build.json && cem analyze && node scripts/gen-tag-map.mjs",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "vite build --config vite.site.config.ts && node scripts/inline-site-css.mjs && node scripts/build-site-routes.mjs",
    "preview:site": "vite preview --config vite.site.config.ts",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:check": "eslint \"src/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"*.{md,json,mjs,ts}\" \"scripts/**/*.mjs\" \".storybook/**/*.ts\" \"sample-app/**/*.{ts,mjs,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"*.{md,json,mjs,ts}\" \"scripts/**/*.mjs\" \".storybook/**/*.ts\" \"sample-app/**/*.{ts,mjs,html}\"",
    "analyze": "cem analyze && node scripts/gen-tag-map.mjs",
    "docs:components": "cem analyze && node scripts/gen-readmes.mjs",
    "analyze:watch": "cem analyze --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "browserstack:serve": "node scripts/serve-static.mjs storybook-static 6006",
    "test": "vitest",
    "test:ci": "vitest run",
    "test-storybook": "vitest --project=storybook",
    "test:visual": "vitest run src/components/__tests__/screenshots.test.ts",
    "test:visual:update": "npm run test:visual -- --update",
    "test:refresh": "vitest run src/components/__tests__/refresh-budget.test.ts",
    "test:browserstack": "node scripts/browserstack-test.mjs",
    "test:coverage": "vitest --coverage",
    "test:coverage:ci": "vitest run --coverage",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "validate:sample-app": "node sample-app/validate.mjs",
    "validate:sample-app:types": "tsc -p sample-app/tsconfig.json",
    "pages:index": "node scripts/gen-pages-index.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "prepublishOnly": "npm run lint:check && npm run type-check && npm run build",
    "build-browserstack": "vite build && browserstack-node-sdk node scripts/build-css.mjs && tsc -p tsconfig.build.json && cem analyze && node scripts/gen-tag-map.mjs",
    "build:site-browserstack": "vite build --config vite.site.config.ts && browserstack-node-sdk node scripts/inline-site-css.mjs && node scripts/build-site-routes.mjs",
    "analyze-browserstack": "cem analyze && browserstack-node-sdk node scripts/gen-tag-map.mjs",
    "docs:components-browserstack": "cem analyze && browserstack-node-sdk node scripts/gen-readmes.mjs",
    "browserstack:serve-browserstack": "browserstack-node-sdk node scripts/serve-static.mjs storybook-static 6006",
    "test:browserstack-browserstack": "browserstack-node-sdk node scripts/browserstack-test.mjs",
    "validate:sample-app-browserstack": "browserstack-node-sdk node sample-app/validate.mjs",
    "pages:index-browserstack": "browserstack-node-sdk node scripts/gen-pages-index.mjs",
    "bump-version-browserstack": "browserstack-node-sdk node scripts/bump-version.mjs"
  },
  "size-limit": [
    {
      "name": "barrel (all components)",
      "path": "dist/index.js",
      "limit": "40 KB"
    },
    {
      "name": "e-button (single component)",
      "path": "dist/components/button.js",
      "limit": "6 KB"
    },
    {
      "name": "e-input (single component)",
      "path": "dist/components/input.js",
      "limit": "8 KB"
    }
  ],
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@eslint/js": "10.0.1",
    "@size-limit/preset-small-lib": "13.0.3",
    "@storybook/addon-a11y": "10.5.9",
    "@storybook/addon-docs": "10.5.9",
    "@storybook/addon-vitest": "10.5.9",
    "@storybook/web-components-vite": "10.5.9",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "browserstack-node-sdk": "^1.66.1",
    "custom-element-jet-brains-integration": "1.7.0",
    "custom-element-vs-code-integration": "1.5.0",
    "eslint": "10.8.1",
    "lightningcss": "1.33.0",
    "lit": "3.3.3",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "size-limit": "13.0.3",
    "storybook": "10.5.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "vitest-sonar-reporter": "3.0.0"
  },
  "overrides": {
    "rolldown": "1.2.4"
  }
}
