{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/demo/**/*",
    "src/site/**/*",
    "src/stories/**/*",
    "src/**/*.stories.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
