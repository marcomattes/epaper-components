    "THEMING.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "contributes": {
    "html": {
      "customData": [
        "./dist/vscode.html-custom-data.json"
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && node scripts/build-css.mjs && tsc -p tsconfig.build.json && cem analyze && node scripts/gen-tag-map.mjs",
    "preview": "vite preview",
    "analyze": "cem analyze && node scripts/gen-tag-map.mjs",
    "docs:components": "cem analyze && node scripts/gen-readmes.mjs",
    "analyze:watch": "cem analyze --watch",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "bump-version": "node scripts/bump-version.mjs",
    "prepack": "node scripts/copy-root-docs.mjs",
    "prepublishOnly": "npm run build",
    "build-browserstack": "vite build && browserstack-node-sdk node scripts/build-css.mjs && tsc -p tsconfig.build.json && cem analyze && node scripts/gen-tag-map.mjs",
    "analyze-browserstack": "cem analyze && browserstack-node-sdk node scripts/gen-tag-map.mjs",
    "docs:components-browserstack": "cem analyze && browserstack-node-sdk node scripts/gen-readmes.mjs",
    "bump-version-browserstack": "browserstack-node-sdk node scripts/bump-version.mjs"
  },
  "size-limit": [
    {
      "name": "barrel (all components)",
      "path": "dist/index.js",
      "limit": "40 KB"
    },
    {
      "name": "e-button (single component)",
      "path": "dist/components/button.js",
      "limit": "6 KB"
    },
    {
      "name": "e-input (single component)",
      "path": "dist/components/input.js",
      "limit": "8 KB"
    }
  ]
}
