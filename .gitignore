# Dependencies
node_modules/

# Build output
dist/
dist-site/
storybook-static/

# Test / coverage output
coverage/
reports/
test-results/
playwright-report/
# Written by `toMatchScreenshot` on a mismatch (actual/diff/reference PNGs).
# Not ignoring it leaves the tree dirty after any failed visual run and makes
# it easy to commit a screenshot generated by the wrong Chromium build.
.vitest-attachments/

# SonarScanner working directory and downloaded CLI
.scannerwork/
.sonar/

# OS / editor cruft 
.DS_Store
Thumbs.db
*.log

# Internal working notes — not part of the published source
Review.md

# Local Claude Code state (settings, session data) — project skills under
# .claude/skills/ are checked in and shared with the team, everything else
# in .claude/ is per-machine and stays ignored.
.claude/*
!.claude/skills/
# Vitest writes a screenshot of the page when a browser-mode test fails, into
# __screenshots__/<file>.test.ts/<test name>-1.png. Those are failure
# artifacts, not baselines — the committed baselines sit flat in
# __screenshots__/ — and a pair of them was swept into the repo once already.
**/__screenshots__/*.test.ts/
